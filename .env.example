# Root-level defaults loaded by scripts/dev-*.sh before app-specific env files.
# Keep non-secret shared values here. Override in service-level env files as needed.

# Shared network defaults
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_NETWORK_ONLY=1
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Local URL defaults
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
DATABASE_URL=postgresql://synapse:synapse@127.0.0.1:5432/synapse?schema=public
PORT=3000
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8787
