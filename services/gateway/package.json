    "@x402/core": "^2.9.0",
    "@x402/stellar": "^2.9.0",
    "fastify": "^5.8.4",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "mppx": "^0.4.11",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
