# Shared runtime env
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_LOG_LEVEL=info
DATABASE_URL=postgresql://synapse:synapse@127.0.0.1:5432/synapse?schema=public

# Receipt signer configuration
# Used to produce verifiable signed receipt envelopes for paid and free invocations.
# Defaults are development-safe only and should be overridden in production.
# GATEWAY_RECEIPT_SIGNER_ID=synapse-gateway
# GATEWAY_RECEIPT_SIGNING_SECRET=dev-receipt-secret

# Payment provider selection
# Set to x402 or mpp. Defaults to x402 when omitted.
GATEWAY_PAYMENT_PROVIDER=x402

# Shared payment + Stellar verification env
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Payout recipient for paid operations.
# This must be a provider/settler-owned Stellar address (G... account or C... contract), not a caller address.
GATEWAY_PAY_TO_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GATEWAY_CHALLENGE_TTL_SECONDS=60
GATEWAY_MAX_PROOF_AGE_MS=300000
GATEWAY_HORIZON_URL=https://horizon-testnet.stellar.org
GATEWAY_MAX_TX_AGE_MS=600000
GATEWAY_IDEMPOTENCY_TTL_MS=600000

# x402-only vars (required when GATEWAY_PAYMENT_PROVIDER=x402)
GATEWAY_X402_FACILITATOR_URL=https://x402.org/facilitator

# mpp-only vars (required when GATEWAY_PAYMENT_PROVIDER=mpp)
MPP_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional; defaults to network USDC SAC when unset.
# MPP_CURRENCY=CDLZFC3SY2... (SAC address)

# Soroban invocation mode
# Use network-only mode for preconfigured local/global profiles.
SOROBAN_NETWORK_ONLY=1
SOROBAN_NETWORK=testnet

# Required if SOROBAN_NETWORK_ONLY is not 1.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Source signer: set one of these.
SOROBAN_SOURCE_ALIAS=alice
SOROBAN_SOURCE_ACCOUNT=
SOROBAN_ACCOUNT=
